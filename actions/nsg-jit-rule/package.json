{
  "name": "nsg-jit-rule",
  "version": "1.0.0",
  "description": "GitHub Action to create or update NSG just-in-time access rules",
  "main": "index.js",
  "author": "BC Government",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@azure/identity": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && esbuild cleanup.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist-cleanup/cleanup.js",
    "start": "node index.js",
    "verify": "node -c index.js && node -c cleanup.js"
  }
}
