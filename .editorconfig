# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# 2 space indentation
[*.{js,json,yaml,yml,md}]
indent_style = space
indent_size = 2

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 100

# YAML files (strict formatting)
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# Node.js config files
[{package.json,*.lock}]
indent_style = space
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab
